<?xml version="1.0" encoding="utf-8"?>
<templates>
    <div t-name="spreadsheet_edition.BooleanFilterEditorSidePanel" class="o_spreadsheet_filter_editor_side_panel">
        <Section title.translate="Label">
            <TextInput
                placeholder="placeholder"
                class="'o_global_filter_label' + (missingLabel ? ' o_field_invalid' : '')"
                value="genericState.label || ''"
                onChange.bind="setLabel"
                autofocus="true"
            />
        </Section>
        <Section title.translate="Default value">
            <BooleanMultiSelector
                selectedValues="booleanState.defaultValue"
                update.bind="updateDefaultValues"
            />
        </Section>
        <t t-if="shouldDisplayFieldMatching()">
            <SidePanelCollapsible collapsedAtInit="!isNewFilter" title.translate="Field matching">
                <t t-set-slot="content">
                    <Section class="'pt-0'">
                        <FilterEditorFieldMatching
                            fieldMatchings="fieldMatchings"
                            wrongFieldMatchings="wrongFieldMatchings"
                            selectField.bind="onSelectedField"
                            filterModelFieldSelectorField.bind="filterModelFieldSelectorField"
                        />
                    </Section>
                </t>
            </SidePanelCollapsible>
        </t>
        <div class="o-section o-sidePanelButtons">
            <t t-call="spreadsheet_edition.FilterEditorButtons">
                <t t-set="onDelete" t-value="this.props.id and onDelete.bind(this)" />
                <t t-set="onSave" t-value="onSave.bind(this)" />
                <t t-set="onCancel" t-value="onCancel.bind(this)" />
            </t>
        </div>
    </div>
</templates>
