<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="documents.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="primary">
        <xpath expr="//t[@t-else='']/Breadcrumbs" position="replace">
            <DocumentsBreadcrumbs breadcrumbs="pathBreadcrumbs"/>
        </xpath>

        <xpath expr="//div[hasclass('o_control_panel_actions')]" position="inside">
            <DocumentsAction t-if="!documentService.previewedDocument" folderId="currentFolderId" targetRecords="this.env.model.root.selection"/>
        </xpath>

        <xpath expr="//*[hasclass('o_control_panel_navigation')]" position="inside">
            <button t-if="documentService.userIsInternal"
                t-on-click="() => this.documentService.toggleChatterState()"
                data-tooltip="Info &amp; tags"
                class="btn btn-secondary o_switch_view o_kanban d-none d-md-inline"
                t-att-class="{'active': this.chatterState.visible}">
                <i t-attf-class="fa fa-fw {{ this.chatterState.visible ? 'fa-close' : 'fa-info-circle' }} mt-1"/>
            </button>
        </xpath>

        <xpath expr="//div[hasclass('o_cp_pager')]" position="attributes">
            <attribute name="t-if" add="!this.chatterState.visible" separator=" and "/>
        </xpath>

        <xpath expr="//nav[hasclass('o_cp_switch_buttons')]" position="attributes">
            <attribute name="t-if" add="!documentService.previewedDocument" separator=" and "/>
        </xpath>
    </t>
</templates>
