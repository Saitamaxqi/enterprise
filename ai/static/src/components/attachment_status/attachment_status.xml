<templates>
    <div t-name="ai.AttachmentsProcessingStatus" t-if="state.stats.percentage !== 100">
        <div t-attf-class="alert alert-warning mb-0 py-2 px-3 w-100 d-flex justify-content-center align-items-center">
            <div class="d-flex align-items-center">
                <i t-attf-class="fa fa-clock-o me-2" />
                <span>Processing your sources, it might take a few minutes...</span>
            </div>
            <button t-if="state.stats.status !== 'success'" class="btn btn-sm btn-link" t-on-click="fetchStats" t-att-disabled="state.isRefreshing">
                <span class="me-1">Refresh</span>
                <i t-if="state.isRefreshing" class="fa fa-circle-o-notch fa-spin me-1"/>
                <i t-else="" class="fa fa-refresh me-1"/>
            </button>
        </div>
    </div>
</templates>
