<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_composer_form" model="ir.ui.view">
        <field name="name">ai.composer.form</field>
        <field name="model">ai.composer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Rule Name"/>
                        <h2>
                            <field name="name" readonly="is_system_default"/>
                        </h2>
                    </div>
                    <group col="2">
                        <group colspan="2">
                            <field name="interface_key" widget="selection_badge" readonly="is_system_default"/>
                            <field name="focused_models" widget="many2many_tags" readonly="is_system_default" placeholder="All Models"/>
                        </group>
                        <group colspan="1">
                            <field name="ai_agent" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div>
                        <label for="default_prompt" string="System Prompt for Composer"/>
                        <field name="default_prompt"/>
                    </div>
                    <notebook>
                        <page name="user_prompts_page" string="Buttons">
                            <field name="available_prompts" mode="list">
                                <list editable="bottom" open_form_view="False">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_composer_tree" model="ir.ui.view">
        <field name="name">ai.composer.list</field>
        <field name="model">ai.composer</field>
        <field name="arch" type="xml">
            <list string="Default Prompts">
                <field name="name" readonly="1"/>
                <field name="interface_key"/>
                <field name="focused_models"/>
                <field name="ai_agent"/>
            </list>
        </field>
    </record>

    <record id="ai_composer_kanban" model="ir.ui.view">
        <field name="name">ai.composer.kanban</field>
        <field name="model">ai.composer</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bolder" string="Name"/>
                        <div class="d-flex flex-column">
                            <field name="interface_key"/>
                            <field name="focused_models"/>
                            <field name="ai_agent"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_composer_action" model="ir.actions.act_window">
        <field name="name">Default Prompts</field>
        <field name="res_model">ai.composer</field>
        <field name="view_id" ref="ai_composer_tree"/>
        <field name="view_mode">list,kanban,form</field>
    </record>

</odoo>
