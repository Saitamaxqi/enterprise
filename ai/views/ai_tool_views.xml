<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ai_tool_view_search" model="ir.ui.view">
        <field name="name">ai.tool.view.search</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="method_name"/>
            </search>
        </field>
    </record>

    <record id="ai_tool_view_list" model="ir.ui.view">
        <field name="name">ai.tool.list</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="display_name" string="Tool Name" />
                <field name="description"/>
                <field name="method_name" optional="hide"/>
            </list>
        </field>
    </record>

</odoo>
