<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="documents_spreadsheet.DocumentsAction" t-inherit="documents.DocumentsAction" t-inherit-mode="extension">
        <xpath expr="//*[hasclass('o_documents_share_button')]" position="after">
            <button type="button" class="btn btn-secondary d-none d-lg-inline"
                t-if="userIsInternal and singleSelection?.data?.handler === 'spreadsheet'"
                t-on-click.prevent="onClickFreezeAndShareSpreadsheet" data-hotkey="s">
                <t t-call="spreadsheet_edition.SpreadsheetIcon"/> Freeze and share
            </button>
        </xpath>
        <xpath expr="//*[hasclass('o_documents_download_button')]" position="attributes">
            <attribute name="t-if">
                props.targetRecords.some((r) => this.hasDocumentAttachment(r) and r.data.handler !== "spreadsheet")
            </attribute>
        </xpath>
    </t>

    <t t-name="spreadsheet.documents.ControlPanelActionItems" t-inherit="documents.ControlPanelActionItems" t-inherit-mode="extension">
        <xpath expr="//*[hasclass('o_documents_download_item')]" position="attributes">
            <attribute name="t-if">
                props.targetRecords.some((r) => this.hasDocumentAttachment(r) and r.data.handler !== "spreadsheet")
            </attribute>
        </xpath>
        <xpath expr="//*[hasclass('o_documents_share_item')]" position="after">
            <button class="dropdown-item w-100 d-lg-none"
                t-if="userIsInternal and singleSelection?.data?.handler === 'spreadsheet'"
                t-on-click.prevent="onClickFreezeAndShareSpreadsheet">
                <t t-call="spreadsheet_edition.SpreadsheetIcon"/>
                <span class="d-inline-block ms-1">Freeze and Share</span>
            </button>
        </xpath>
        <xpath expr="//*[hasclass('o_documents_export')]" position="after">
            <button class="dropdown-item w-100"
                t-if="userIsInternal and this.documentsState.viewType === 'list'"
                t-on-click="() => this.onInsertInSpreadsheet()">
                <i class="oi oi-view-list fa-fw me-1"/>
                <span class="d-inline-block">Insert in spreadsheet</span>
            </button>
        </xpath>
    </t>
</templates>
