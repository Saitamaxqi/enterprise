<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_reload_drivers_wizard" model="ir.ui.view">
        <field name="name">iot.reload.drivers.wizard.form</field>
        <field name="model">iot.reload.drivers.wizard</field>
        <field name="arch" type="xml">
            <form string="Reload IoT Drivers">
                <p>
                    The new module(s) installed require new drivers for the IoT.
                    To ensure full compatibility and proper functionality, we recommend restarting your IoT box now.
                </p>
                <p>
                    Please ensure the IoT box is not in use before restarting.
                    You can also restart it manually later, but doing it now will provide the best experience.
                </p>
                <group class="col-md-8">
                    <field name="iot_box_ids" widget="many2many_tags" placeholder="None"/>
                </group>
                
                <footer>
                    <button class="btn-primary" type="object" name="action_update_boxes">Restart</button>
                    <button class="btn-secondary" special="cancel">Discard</button>
                </footer>
            </form>
        </field>
    </record>
</odoo>
