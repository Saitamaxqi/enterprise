<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.view.form.inherit.l10_lu_hr_payroll</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <group name="salary_left" position="inside">
                <label for="l10n_lu_indexed_wage" invisible="country_code != 'LU'"/>
                <div class="o_row" name="wage" invisible="country_code != 'LU'">
                    <field name="l10n_lu_indexed_wage" string="Indexed Wage" class="o_hr_narrow_field"/>
                    <div invisible="wage_type != 'monthly'">/ month</div>
                    <div invisible="wage_type != 'hourly'">/ hour</div>
                </div>
                <field
                    name="l10n_lu_index_on_contract_signature"
                    string="Index on Contract Signature"
                    invisible="country_code != 'LU'"
                    class="o_hr_narrow_field"/>
                <field
                    name="l10n_lu_current_index"
                    string="Current Index"
                    class="o_hr_narrow_field"
                    invisible="country_code != 'LU'"/>
            </group>
            <group name="salary_info" position="after">
                <group>
                    <group name="l10n_lu_bik" string="Benefits in Kind" invisible="country_code != 'LU'">
                        <label for="l10n_lu_bik_vehicle"/>
                        <div class="o_row">
                            <field name="l10n_lu_bik_vehicle" string="Vehicle" class="o_hr_narrow_field"/>
                            <div>/ month</div>
                            <field name="l10n_lu_bik_vehicle_vat_included"/>
                            <div>VAT Included</div>
                        </div>
                        <label for="l10n_lu_bik_other_benefits"/>
                        <div class="o_row">
                            <field name="l10n_lu_bik_other_benefits" class="o_hr_narrow_field"/>
                            <div>/ month</div>
                        </div>
                    </group>

                    <group name="l10n_lu_alw" string="Allowances" invisible="country_code != 'LU'">
                        <label for="l10n_lu_alw_vehicle"/>
                        <div class="o_row">
                            <field name="l10n_lu_alw_vehicle" string="Vehicle Package" class="o_hr_narrow_field"/>
                            <div>/ month</div>
                        </div>
                    </group>

                    <group name="l10n_lu_advantages" string="Meal Vouchers" invisible="country_code != 'LU'">
                        <label for="l10n_lu_meal_voucher_amount"/>
                        <div class="o_row">
                            <field name="l10n_lu_meal_voucher_amount" string="Daily Amount" class="o_hr_narrow_field"/>
                            <div>/ worked day</div>
                        </div>
                        <label for="l10n_lu_meal_voucher_employer_cost"/>
                        <div class="o_row">
                            <field name="l10n_lu_meal_voucher_employer_cost" string="Employer Contribution" class="o_hr_narrow_field"/>
                            <div>/ worked day</div>
                        </div>
                        <field name="l10n_lu_meal_voucher_employee_computation" string="Employee Computation" widget="radio"/>
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
