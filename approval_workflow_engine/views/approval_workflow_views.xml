<odoo>
    <record id="view_approval_workflow_list" model="ir.ui.view">
        <field name="name">approval.workflow.list</field>
        <field name="model">approval.workflow</field>
        <field name="arch" type="xml">
            <list string="Approval Workflows">
                <field name="name"/>
                <field name="model_name"/>
                <field name="stage_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_approval_workflow_form" model="ir.ui.view">
        <field name="name">approval.workflow.form</field>
        <field name="model">approval.workflow</field>
        <field name="arch" type="xml">
            <form string="Approval Workflow">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="model_name"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Stages">
                            <field name="stages_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="comment_required"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_approval_workflow" model="ir.actions.act_window">
        <field name="name">Approval Workflows</field>
        <field name="res_model">approval.workflow</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
