<odoo>
    <record id="view_approval_request_list" model="ir.ui.view">
        <field name="name">approval.request.list</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests">
                <field name="name"/>
                <field name="workflow_id"/>
                <field name="requester_id"/>
                <field name="stage_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_approval_request_form" model="ir.ui.view">
        <field name="name">approval.request.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request">
            <header>
            <button name="action_submit" string="Submit" type="object"  class="btn-primary" invisible="state != 'draft'"/>
            <button name="action_open_approve_wizard" string="Approve" type="object" class="btn-success"/>
            <button name="action_open_reject_wizard" string="Reject" type="object" class="btn-danger"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,waiting,in_progress,approved,rejected"/>
            </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workflow_id"/>
                        <field name="requester_id"/>
                        <field name="stage_id"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Logs">
                            <field name="log_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="action_date"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
<chatter/>
            </form>
        </field>
    </record>

    <record id="action_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>