<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="action_approval_action_wizard" model="ir.actions.act_window">
        <field name="name">Approval Action</field>
        <field name="res_model">approval.action.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>    
    </record>
    <record id="view_approval_action_wizard_form" model="ir.ui.view">
        <field name="name">approval.action.wizard.form</field>
        <field name="model">approval.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Approval Action">
                <group>
                    <field name="request_id" readonly="1"/>
                    <field name="action_type" readonly="1"/>
                    <field name="stage_comment_required" invisible="1"/>
                    <field name="comment" nolabel="1" placeholder="Type your comment here..."/>
                    <label for="comment" string="Write a comment about why you did this action" colspan="2"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>