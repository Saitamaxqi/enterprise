<templates id="template" xml:space="preserve">
    <t t-name="ai_website_livechat.SupportAIComponent">
        <div id="ai-messages" class="col pb-9" t-ref="messagesDiv" t-if="state.messages.length">
            <div t-foreach="state.messages" t-as="message" t-key="message_index"
                class="position-relative py-1 o_support_page_message"
                t-att-class="{
                    'mt-2': message_index,
                    'mt-0': !message_index,
                    'px-3': message.author !== 'assistant',
                }"
            >
                <div class="position-relative d-flex flex-shrink-0">
                    <div class="w-100 o-min-width-0">
                        <div class="position-relative d-flex"
                            t-att-class="{
                                            'justify-content-end': message.author === 'user' and message.isError !== true,
                                        }">
                            <div class="o-min-width-0">
                                <div class="position-relative d-flex">
                                    <div class="position-relative overflow-x-auto d-inline-block o_support_ai_message_with_copy_button">
                                        <div class="rounded position-relative text-break py-2 align-self-start"
                                            t-att-class="{
                                                'px-3': message.author !== 'assistant' or message.isError,
                                                'bg-200': message.author === 'user' and message.isError !== true,
                                                'bg-body': message.author === 'assistant' and message.isError !== true,
                                                'bg-danger opacity-25': message.isError,
                                            }
                                            ">
                                            <div class="d-inline o_support_ai_message_content" t-att-class="{'o_user_ai_message': message.author === 'user' or message.isError}">
                                                    <!-- assistant IS THINKING -->
                                                <div t-if="message.author === 'assistant' and !('text' in message)" class="d-flex align">
                                                    <img src="/web/static/img/spin.svg" alt="Loading..." class="me-2"
                                                        style="filter:invert(1); opacity: 0.5; width: 30px; height: 30px;"/>
                                                    <p class="m-0 text-muted align-self-center">
                                                        <em>Thinking...</em>
                                                    </p>
                                                </div>
                                                    <!-- assistant OR USER MESSAGE -->
                                                <div t-elif="message.isError" class="o-message-error">
                                                    <t t-out="message.text"/>
                                                </div>
                                                <t t-else="">
                                                    <t t-out="formatContent(message.text)"/>
                                                    <t t-if="message.sources &amp;&amp; message.sources.length">
                                                        <h5>Sources:</h5>
                                                        <ol>
                                                        <t t-foreach="message.sources" t-as="source" t-key="source_index">
                                                            <li><a t-att-href="source['retrievedContext']['uri']" target="_blank"><t t-out="source['retrievedContext']['title']"/></a></li>
                                                        </t>
                                                        </ol>
                                                    </t>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="o_show_on_message_hover" t-if="message.author === 'assistant' and message.isError !== true and 'text' in message">
                                            <button class="btn p-0 border-0" t-on-click="copyAnswer" t-att-data-message-id="message_index"><i class="fa fa-fw fa-clone fa-sm text-muted"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col" t-att-class="{'o_support_ai_input_sticky': state.messages.length,}">
                <div class="mb-1" t-att-class="{'d-none': !state.messages.length,}">
                    <button t-if="livechatAvailable" class="btn btn-primary small rounded-2 py-1 px-3 me-3 o-disable-thinking" disabled="" t-on-click="askHuman">Ask a Human</button>
                    <a t-elif="props.fallbackButtonURL" class="btn btn-primary small rounded-2 py-1 px-3 me-3 o-disable-thinking" disabled="" t-att-href="props.fallbackButtonURL">
                        <t t-out="props.fallbackButtonText"/>
                    </a>
                    <button class="btn btn-secondary small rounded-2 py-1 px-3 me-3 o-disable-thinking" disabled="" t-on-click="closeConversation">Close</button>
                </div>
                <div class="d-flex align-items-center border rounded">
                    <textarea type="text" id="promptInput" t-ref="promptInput"
                        name="promptInput" t-on-keydown="onTextareaKeydown"
                        class="form-control overflow-hidden border-0 rounded shadow-none flex-grow"
                        style="resize:none;"
                        t-att-placeholder="props.promptPlaceholder"
                        autocomplete="off"
                        t-att-maxlength ="props.promptMax"
                        t-model="state.prompt" required="required"></textarea>
                    <div class="p-2">
                        <button class="s_ai_livechat_generate_response_btn btn border-0 rounded-2 p-1 m1" t-att-class="state.prompt.trim().length ? 'bg-o-color-1' : 'disabled'" style="aspect-ratio:1;" t-on-click="submitPrompt">
                            <i class="fa fa-fw fa-lg fa-paper-plane fs-5" style="scale: .75;"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div t-if="livechatAvailable || props.fallbackButtonURL" class="col-lg-4 col-xxl-3 d-flex align-items-center pt-4 pt-lg-0 support-secondary">
                <span class="pe-4 me-2 text-600">or</span>
                <button t-if="livechatAvailable" class="btn btn-primary w-lg-100 ask-human" t-on-click="askHuman">Ask a Human</button>
                <a t-elif="props.fallbackButtonURL" class="btn btn-primary w-lg-100 fallback-btn" t-att-href="props.fallbackButtonURL">
                    <t t-out="props.fallbackButtonText"/>
                </a>
            </div>
        </div>
    </t>
</templates>
