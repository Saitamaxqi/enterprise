<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.WorkOrder">
        <li class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center gap-2 border-bottom cursor-pointer"
            t-att-class="active ? 'o_active' : ''" t-on-click="onClick">
            <div class="o_mrp_operation_name">
                <span t-esc="props.record.data.name"/>
                <button t-if="!isComplete" t-out="workcenter[1]"
                    class="btn ms-1 py-0 px-2 text-truncate"
                    t-attf-class="o_workcenter_item_color_{{workcenter[0] % 11}}"/>
            </div>
            <i t-attf-class="fa {{isComplete ? 'fa-check text-success pass' : 'fa-chevron-right text-muted'}}"/>
        </li>
    </t>
</templates>
