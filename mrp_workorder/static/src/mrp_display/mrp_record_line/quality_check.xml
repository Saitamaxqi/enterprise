<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_workorder.QualityCheck">
        <li class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center cursor-pointer"
            t-on-click="onClick">
            <span class="o_line_label text-truncate"
                  t-att-class="isComplete ? 'text-decoration-line-through opacity-25' : ''"
                  t-out="label"/>
            <div>
                <span t-if="showQty" t-out="showQty" class="o_line_value me-1 fw-bold"/>
                <button t-if="hasInstruction" t-on-click.stop="showWorksheet" class="o_btn_icon btn btn-outline-secondary me-1"
                        t-att-class="{'d-none': !props.clickable}">
                    <i class="fa fa-info" role="presentation"/>
                </button>
                <button class="o_btn_icon btn" t-att-class="{'p-0' : showImage, 'd-none': !props.clickable}"
                        t-attf-class="{{isActive ? activeClass : 'btn-outline-secondary'}}">
                    <i t-if="!showImage" t-att-class="icon"/>
                    <img t-else="" style="max-width: 35px; max-height: 35px;" t-att-src="imageUrl"/>
                    <!-- CLPI: maybe better to use bg image with contain on the button instead -->
                </button>
            </div>
        </li>
        <FileUploader t-if="props.record.data.test_type === 'picture'"
                      acceptedFileExtensions="'image/*'"
                      t-key="props.record.resId"
                      onUploaded.bind="onFileUploaded">
            <t t-set-slot="toggler"><span t-ref="fileUploaderToggle" class="d-none"/></t>
        </FileUploader>
    </t>
</templates>
