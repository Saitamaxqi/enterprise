<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">view.employee.form.inherit.hr.employee.billable.time.target</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <group name="application_group" position="inside">
                <field name="show_billable_time_target" invisible="1"/>
                <span class="o_wrap_label" invisible="not show_billable_time_target">
                    <label for="billable_time_target" groups="hr_timesheet.group_hr_timesheet_approver"/>
                </span>
                <span class="d-flex w-50" name="billable_time_target" invisible="not show_billable_time_target">
                    <field name="billable_time_target" widget="timesheet_uom_no_toggle" groups="hr_timesheet.group_hr_timesheet_approver"/>
                    <span class="m-14 w-100" groups="hr_timesheet.group_hr_timesheet_approver">per month</span>
                </span>
            </group>
        </field>
    </record>

    <record id="sale_timesheet_employee_list_inherit" model="ir.ui.view">
        <field name="name">sale.timesheet.employee.list.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_employee_list_view"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="timesheet_manager_id" optional="hide" string="Timesheet Approver" widget="many2one_avatar"/>
            </xpath>
            <xpath expr="//field[@name='resource_calendar_id']" position="after">
                <field name="billable_time_target" widget="timesheet_uom" avg="Average"/>
            </xpath>
        </field>
    </record>

    <record id="action_open_view_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="path">employee-timesheet</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'chat_icon': True}</field>
        <field name="view_id" ref="hr.hr_employee_list_view"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new employee
            </p><p>
                Quickly find all the information you need for your employees such as contact data, job position, availability, etc.
            </p>
        </field>
    </record>
</odoo>
