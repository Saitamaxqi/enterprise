<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Rule for normal employees -->
    <record id="asset_move_employee_rule" model="ir.rule">
        <field name="name">Employee Asset Moves</field>
        <field name="model_id" ref="model_asset_move_history"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('to_employee_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Rule for admins (full access) -->
    <record id="asset_move_admin_rule" model="ir.rule">
        <field name="name">Admin Asset Moves</field>
        <field name="model_id" ref="model_asset_move_history"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
