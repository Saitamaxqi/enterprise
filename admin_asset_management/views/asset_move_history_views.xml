<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<record id="action_asset_moves" model="ir.actions.act_window">
    <field name="name">Asset Moves</field>
    <field name="res_model">asset.move.history</field>
    <field name="view_mode">list</field>
</record>

    <record id="view_move_history_list" model="ir.ui.view">
        <field name="name">asset.move.history.list</field>
        <field name="model">asset.move.history</field>
        <field name="arch" type="xml">

            <list editable="top" decoration-danger="state == 'declined'" decoration-success="state == 'assigned'">
                <field name="asset_id"/>
                <field name="from_employee_id"/>
                <field name="to_employee_id" groups="base.group_system"/>
                <field name="from_location_id" groups="base.group_system"/>
                <field name="to_location_id" groups="base.group_system"/>
                <field name="move_date"/>
                <button name="set_assigned" icon="fa-check" type="object" class="oe_highlight" invisible="state != 'draft' or not is_current_user"/>
                <button name="set_declined" icon="fa-close" type="object" class="oe_highlight" invisible="state != 'draft' or not is_current_user"/>
            </list>
        </field>
    </record>
</odoo>