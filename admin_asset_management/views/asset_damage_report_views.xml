<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_asset_damage_report" model="ir.actions.act_window">
        <field name="name">Damage Reports</field>
        <field name="res_model">asset.damage.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_asset_damage_report_list" model="ir.ui.view">
        <field name="name">asset.damage.report.list</field>
        <field name="model">asset.damage.report</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="damage_type"/>
                <field name="severity"/>
                <field name="reported_by"/>
                <field name="date_reported"/>
            </list>
        </field>
    </record>

    <record id="view_asset_damage_report_form" model="ir.ui.view">
        <field name="name">asset.damage.report.form</field>
        <field name="model">asset.damage.report</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="asset_id"/>
                        <field name="reported_by"/>
                        <field name="damage_type"/>
                        <field name="severity"/>
                        <field name="description"/>
                        <field name="date_reported"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

  
    <record id="view_account_asset_form_inherit_damage" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.damage</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Damage Reports">
                    <field name="damage_report_ids" context="{'default_asset_id': id}"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
