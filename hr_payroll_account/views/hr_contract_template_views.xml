<?xml version="1.0"?>
<odoo>
    <record id="hr_contract_template_form_view" model="ir.ui.view">
        <field name="name">hr.contract.template.form.inherit.hr.payroll.account</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <group name="other" position="after">
                <group string="Accounting" groups="analytic.group_analytic_accounting">
                    <field name="analytic_account_id"
                        domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]"
                        groups="analytic.group_analytic_accounting"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
