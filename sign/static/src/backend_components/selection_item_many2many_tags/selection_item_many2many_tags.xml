<?xml version="1.0" encoding="UTF-8"?>
<template id="SelectionItemMany2ManyTagsField">
    <t t-name="sign.SelectionItemMany2ManyTagsField">
        <div t-ref="many2ManyTagsField">
            <ul class="o_sign_item_popover_selection list-unstyled mb-0 mt-1" t-ref="itemsList">
                <div class="input-group" style="min-height: 150px;">
                    <textarea
                        class="o_sign_selection_input_option"
                        placeholder="Enter options separated by Enter."
                        t-att-value="this.getTagsToTextArea()"
                        t-on-change="(ev) => this.onChangeSelection(ev, ev.target.value)"
                        t-on-focusout="(ev) => this.onChangeSelection(ev, ev.target.value)"
                        t-on-keyup="(ev) => this.onKeyUpSelection(ev, ev.target.value)"
                        autofocus="true"
                    />
                </div>
            </ul>
        </div>
    </t>
</template>
