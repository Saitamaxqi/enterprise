<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sign.SignRequestDocumentsDropdown">
        <Dropdown>
            <button type="button" class="btn btn-primary o_sign_download_documents_dropdown o-dropdown-caret" data-hotkey="c">
                Download
            </button>
            <t t-set-slot="content">
                <t t-if="signInfo.get('signRequestState') == 'signed'">
                    <t t-if="(signInfo.get('completed_documents')||[]).length > 1">
                        <DropdownItem class="'o_sign_download_all_completed_documents_dropdown_item'" attrs="{href: `/sign/download/${signInfo.get('documentId')}/${signInfo.get('signRequestToken')}/completed`}">
                            All Documents (zip)
                        </DropdownItem>
                        <div role="separator" class="dropdown-divider"/>
                    </t>
                    <t t-foreach="signInfo.get('completed_documents') || []" t-as="doc" t-key="doc.id">
                        <DropdownItem class="'o_sign_download_single_document_dropdown_item'" attrs="{href: `/sign/download/${signInfo.get('documentId')}/${signInfo.get('signRequestToken')}/completed/${doc.id}`}">
                            <t t-esc="doc.name"/>
                        </DropdownItem>
                    </t>
                </t>
                <t t-if="signInfo.get('needToSign')">
                    <t t-if="(signInfo.get('original_documents')||[]).length > 1">
                        <DropdownItem class="'o_sign_download_all_original_documents_dropdown_item'" attrs="{href: `/sign/download/${signInfo.get('documentId')}/${signInfo.get('signRequestToken')}/origin`}">
                            All Documents (zip)
                        </DropdownItem>
                        <div role="separator" class="dropdown-divider"/>
                    </t>
                    <t t-foreach="signInfo.get('original_documents') || []" t-as="doc" t-key="doc.id">
                        <DropdownItem class="'o_sign_download_original_documents_dropdown_item'" attrs="{href: `/sign/download/${signInfo.get('documentId')}/${signInfo.get('signRequestToken')}/origin/${doc.id}`}">
                            <t t-esc="doc.name"/>
                        </DropdownItem>
                    </t>
                </t>
            </t>
        </Dropdown>
    </t>
</templates>
