<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_return_kanban_view" model="ir.ui.view">
        <field name="name">l10n_hr.account.return.kanban</field>
        <field name="model">account.return</field>
        <field name="inherit_id" ref="account_reports.account_return_kanban_view"/>
        <field name="arch" type="xml">
            <a name="action_reset_tax_return_common" position="after">
                <a invisible="type_external_id != 'l10n_hr_reports.hr_ec_sales_list_return_type' or state != 'submitted'"
                   class="dropdown-item"
                   type="object"
                   name="action_reset_tax_return_common"
                   string="Reset"/>
            </a>
        </field>
    </record>
</odoo>
