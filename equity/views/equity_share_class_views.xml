<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equity_share_class_list" model="ir.ui.view">
        <field name="name">equity.share.class.list</field>
        <field name="model">equity.share.class</field>
        <field name="arch" type="xml">
            <list string="Share Classes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="share_votes" width="150px"/>
                <field name="dividend_payout" width="150px"/>
            </list>
        </field>
    </record>

    <record id="view_equity_share_class_form" model="ir.ui.view">
        <field name="name">equity.share.class.form</field>
        <field name="model">equity.share.class</field>
        <field name="arch" type="xml">
            <form string="Share Class">
                <sheet>
                    <group>
                        <field name="name" string="Share Class" placeholder="e.g. Seed, Series A, ..." class="flex-grow-0 w-auto"/>
                        <div class="o_td_label">
                            <label for="share_votes" string="Votes"/>
                        </div>
                        <div class="d-flex">
                            <field name="share_votes" class="flex-grow-0 w-auto"/>
                            <span>per share</span>
                        </div>
                        <field name="dividend_payout"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equity_share_class" model="ir.actions.act_window">
        <field name="name">Share Classes</field>
        <field name="res_model">equity.share.class</field>
        <field name="path">share-classes</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
