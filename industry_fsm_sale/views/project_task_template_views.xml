<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_project_task_template_form_fsm_sale_inherit">
        <field name="name">project.task.template.form.inherited</field>
        <field name="model">project.task.template</field>
        <field name="inherit_id" ref="project.view_project_task_template_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="under_warranty" invisible="not is_fsm"/>
            </field>
        </field>
    </record>

    <record id="view_project_task_template_list_fsm_sale_inherit" model="ir.ui.view">
        <field name="name">project.task.template.list.fsm.inherit</field>
        <field name="model">project.task.template</field>
        <field name="inherit_id" ref="project.view_project_task_template_list"/>
        <field name="arch" type="xml">
            <field name="allocated_hours" position="after">
                <field name="under_warranty" optional="hide" invisible="not is_fsm"/>
            </field>
        </field>
    </record>

</odoo>
