<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="training_locations_action" model="ir.actions.act_window">
    <field name="name">Locations</field>
    <field name="res_model">training.locations</field>
    <field name="view_mode">list,form</field>
</record>
<record id="training_locations_list_view" model="ir.ui.view">
    <field name="name">training.locations.list</field>
    <field name="model">training.locations</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="code"/>
        </list>
    </field>
</record>
<record id="training_locations_form_view" model="ir.ui.view">
    <field name="name">training.locations.form</field>
    <field name="model">training.locations</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>