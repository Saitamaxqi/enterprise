<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<record id="training_teachers_action" model="ir.actions.act_window">
    <field name="name">Teachers</field>
    <field name="res_model">training.teachers</field>
    <field name="view_mode">list,form</field>
</record>
<record id="training_teachers_list_view" model="ir.ui.view">
    <field name="name">training.teachers.list</field>
    <field name="model">training.teachers</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="code"/>
        </list>
    </field>
</record>
<record id="training_teachers_form_view" model="ir.ui.view">
    <field name="name">training.teachers.form</field>
    <field name="model">training.teachers</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                </group>
            </sheet>
        </form>
    </field>
</record>
</odoo>