<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_training_registration" t-name="training.report_training_registration">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
        <div class="page">
            <div class="row">
                <div class="col-6">
                    Company Logo
                </div>
                <div class="col-6 text-end">
                    <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                </div>
            </div>
                <hr/>
                    <h2 style="color: #1d5e99; text-align: center;">Internal Training Details</h2>
                    <strong>Trainee Name: </strong><span t-field="o.trainee_id.name"/>
                    <table class="table table-bordered" style="margin-top: 5%; width: 100%; table-layout: fixed;">
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Serial Number:</strong></td>
                        <td colspan="3"><span t-field="o.course_serial_number"/></td>
                        </tr>
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Course Name:</strong></td>
                        <td colspan="3"><span t-field="o.course_name"/></td>
                        </tr>
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Course Description:</strong></td>
                        <td colspan="3"><span t-field="o.course_desc"/></td>
                        </tr>
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Teacher Name:</strong></td>
                        <td><span t-field="o.teacher_name"/></td>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Time:</strong></td>
                        <td><span t-field="o.time"/>hrs</td>
                        </tr>
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;width: 30%"><strong> Start Date:</strong></td>
                        <td><span t-field="o.start_date"/></td>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> End Date:</strong></td>
                        <td><span t-field="o.end_date"/></td>
                        </tr>
                        <tr>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Room Name:</strong></td>
                        <td><span t-field="o.room_name"/></td>
                        <td style="background-color: #b2b2b2; width: 30%;"><strong> Course Location:</strong></td>
                        <td><span t-field="o.location_name"/></td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </t>
</template>
</odoo>